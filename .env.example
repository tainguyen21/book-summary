NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-auth0-spa-client-id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.bookwise.local
NEXT_PUBLIC_AUTH0_REDIRECT_URI=http://localhost:3000
PORT=3001
APP_DATABASE_URL=postgresql://bookwise:bookwise@localhost:5432/bookwise_next
DATA_DATABASE_URL=postgresql+psycopg://bookwise:bookwise@localhost:5432/bookwise_next
MIGRATION_DATABASE_URL=postgresql://bookwise:bookwise@localhost:5432/bookwise_next
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_PROVIDER=minio
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=bookwise
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
OIDC_ISSUER=https://your-tenant.us.auth0.com/
OIDC_AUDIENCE=https://api.bookwise.local
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRY_SECONDS=600
GCS_BUCKET=

# Model providers are configured only for the private Python worker.
# BOOKWISE_MODEL_PROVIDER supports "openai", "vertex", or an
# OpenAI-compatible provider name.
# Use OPENAI_API_KEY for OpenAI, or BOOKWISE_MODEL_API_KEY for private endpoints.
BOOKWISE_MODEL_PROVIDER=
BOOKWISE_MODEL_BASE_URL=
BOOKWISE_MODEL_API_KEY=
BOOKWISE_SUMMARY_MODEL=
BOOKWISE_EMBEDDING_MODEL=
BOOKWISE_EMBEDDING_DIMENSIONS=
# Region for the API's search query embeddings (falls back to GOOGLE_CLOUD_LOCATION).
BOOKWISE_EMBEDDING_LOCATION=asia-southeast1
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
BOOKWISE_MODEL_TIMEOUT_SECONDS=120
BOOKWISE_MODEL_MAX_OUTPUT_TOKENS=16384
# Estimated spend: USD per 1M input/output tokens per model; unpriced models cost 0.
BOOKWISE_MODEL_PRICING_JSON={"gemini-3.8-flash":{"input_per_mtok":1.50,"output_per_mtok":7.50},"gemini-embedding-001":{"input_per_mtok":0.15,"output_per_mtok":0}}
BOOKWISE_GENERATION_CHUNK_CHARS=12000
# Evidence records per summary call; more are summarized in groups first.
BOOKWISE_SUMMARY_GROUP_RECORDS=120
# Estimated USD per local day before summary generation pauses (0 disables).
BOOKWISE_DAILY_BUDGET_USD=2
BOOKWISE_BUDGET_TIMEZONE=Asia/Saigon
PROCESSING_BATCH_LIMIT=1
PROCESSING_POLL_INTERVAL_SECONDS=2
# Request tracing to Cloud Trace (API and worker) via telemetry.googleapis.com;
# set to cloud-trace to enable (uses Application Default Credentials).
BOOKWISE_TRACE_EXPORTER=
BOOKWISE_TRACE_SAMPLE_RATIO=1
# Worker JSON log level on stdout (DEBUG, INFO, WARNING, ERROR); DEBUG adds idle polls.
BOOKWISE_LOG_LEVEL=INFO
