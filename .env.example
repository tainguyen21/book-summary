NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-auth0-spa-client-id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.bookwise.local
NEXT_PUBLIC_AUTH0_REDIRECT_URI=http://localhost:3000
PORT=3001
APP_DATABASE_URL=postgresql://bookwise:bookwise@localhost:5432/bookwise_next
DATA_DATABASE_URL=postgresql+psycopg://bookwise:bookwise@localhost:5432/bookwise_next
MIGRATION_DATABASE_URL=postgresql://bookwise:bookwise@localhost:5432/bookwise_next
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=bookwise
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
OIDC_ISSUER=https://your-tenant.us.auth0.com/
OIDC_AUDIENCE=https://api.bookwise.local
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRY_SECONDS=600

# Model providers are configured only for the private Python worker.
# BOOKWISE_MODEL_PROVIDER supports "openai", "vertex", or an
# OpenAI-compatible provider name.
# Use OPENAI_API_KEY for OpenAI, or BOOKWISE_MODEL_API_KEY for private endpoints.
BOOKWISE_MODEL_PROVIDER=
BOOKWISE_MODEL_BASE_URL=
BOOKWISE_MODEL_API_KEY=
BOOKWISE_SUMMARY_MODEL=
BOOKWISE_EMBEDDING_MODEL=
BOOKWISE_EMBEDDING_DIMENSIONS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
BOOKWISE_MODEL_TIMEOUT_SECONDS=60
BOOKWISE_MODEL_MAX_OUTPUT_TOKENS=4000
BOOKWISE_GENERATION_CHUNK_CHARS=12000
